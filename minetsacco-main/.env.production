VITE_VAPID_PUBLIC_KEY=BN21Dp26FQFRhUYw11RNHgQ1d1tibAFWBVA8Eh-mBuwkvdzxzq_27IXLahyAmXyBHcvWx5tXpMIOpE-RrJSywcE

VITE_APP_ENV=production
VITE_APP_NAME=Minet SACCO
VITE_PRODUCTION=true
