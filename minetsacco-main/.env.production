# Production Environment Variables for Render Deployment
# This file is used when building for production

# Backend API URL (Render)
VITE_API_URL=https://minetsacco-backend-docker.onrender.com

# Native Backend URL (for APK/iOS)
VITE_NATIVE_BACKEND_URL=https://minetsacco-backend-docker.onrender.com

# Application Environment
VITE_APP_ENV=production

# Application Name
VITE_APP_NAME=Minet SACCO

# Enable production optimizations
VITE_PRODUCTION=true
