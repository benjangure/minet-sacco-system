# Production build settings
# Web/PWA is served over HTTPS from https://sacco.minet.co.ke and calls the API on the SAME origin
# (/api is reverse-proxied to the backend - see public/web.config). Leave VITE_API_URL empty.
VITE_API_URL=

# Native Android app talks to the public HTTPS endpoint
VITE_NATIVE_BACKEND_URL=https://sacco.minet.co.ke

