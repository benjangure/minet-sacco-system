{
  "name": "Minet SACCO Member Portal",
  "short_name": "Minet SACCO",
  "version": "4.0.0",
  "description": "Member portal for Minet SACCO - manage loans, savings, and contributions with real-time notifications",
  "start_url": "/member/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ef4444",
  "lang": "en-US",
  "dir": "ltr",
  "icons": [
    {
      "src": "/Minet-Logo1.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["finance", "business", "productivity"],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View your account dashboard",
      "url": "/member/dashboard",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Apply for Loan",
      "short_name": "Apply Loan",
      "description": "Apply for a new loan",
      "url": "/member/apply-loan",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Make Payment",
      "short_name": "Pay Loan",
      "description": "Make a loan payment",
      "url": "/member/dashboard?tab=transact",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Notifications",
      "short_name": "Notifications",
      "description": "View your notifications",
      "url": "/member/dashboard?tab=notifications",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Account Statement",
      "short_name": "Statement",
      "description": "View account statement",
      "url": "/member/account-statement",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/member/dashboard",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+minetsacco",
      "url": "/member/dashboard?action=%s"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "file_handlers": [
    {
      "action": "/member/dashboard",
      "accept": {
        "text/csv": [".csv"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}
