<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic to local network IPs for development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.34</domain>
        <domain includeSubdomains="true">192.168.0.41</domain>
        <domain includeSubdomains="true">192.168.0.50</domain>
        <domain includeSubdomains="true">192.168.0.195</domain>
        <domain includeSubdomains="true">192.168.1.34</domain>
        <domain includeSubdomains="true">192.168.1.50</domain>
        <domain includeSubdomains="true">192.168.1.55</domain>
        <domain includeSubdomains="true">192.168.1.195</domain>
        <domain includeSubdomains="true">192.168.100.34</domain>
        <domain includeSubdomains="true">192.168.100.41</domain>
        <domain includeSubdomains="true">192.168.100.50</domain>
        <domain includeSubdomains="true">192.168.100.54</domain>
        <domain includeSubdomains="true">192.168.100.56</domain>
        <domain includeSubdomains="true">192.168.100.195</domain>
        <domain includeSubdomains="true">10.0.0.34</domain>
        <domain includeSubdomains="true">10.0.0.50</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    
    <!-- Explicitly allow HTTPS to Render backend -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">onrender.com</domain>
        <domain includeSubdomains="true">minetsacco-backend-docker.onrender.com</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
    
    <!-- Base config: Allow all HTTPS, trust system certificates -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
