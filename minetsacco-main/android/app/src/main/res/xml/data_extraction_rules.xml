<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+)
    Controls cloud backup and device-to-device transfer
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app preferences in cloud backup, but exclude sensitive data -->
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="auth_token.xml" />
        <exclude domain="sharedpref" path="user_credentials.xml" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Include app preferences in device transfer, but exclude sensitive data -->
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="auth_token.xml" />
        <exclude domain="sharedpref" path="user_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
