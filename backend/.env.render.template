# Environment Variables Template for Render Deployment
# Copy these to Render Dashboard → Environment Variables

# ===========================================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================================

# Spring Profile (DO NOT CHANGE)
SPRING_PROFILES_ACTIVE=production

# Database URL (Auto-filled by Render when you link database)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=<will-be-filled-by-render>

# JWT Secret (Generate random 64-character string)
# Use PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
JWT_SECRET=<generate-ra

