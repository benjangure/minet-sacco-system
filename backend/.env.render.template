# ===========================================
# OPTIONAL: EMAIL CONFIGURATION
# ===========================================

# If you want to send emails from the app
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# ===========================================
# JVM OPTIONS (ndom-64-char-string>Memory Settings for Free Tier)
# ===========================================

# Limit memory usage to 512MB (free tier has 512MB RAM)
JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m

# ===========================================
# INSTRUCTIONS FOR RENDER DASHBOARD
# ===========================================

# 1. Go to your Render service dashboard
# 2. Click "Environment" tab
# 3. Add each variable above as Key-Value pairs
# 4. DATABASE_URL will be auto-filled when you link the database
# 5. Generate JWT_SECRET using the PowerShell command above
# 6. Save and trigger a manual deploy

