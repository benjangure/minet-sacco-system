# ================================
# BUILD ARTIFACTS & TEMP FILES
# ================================
*.class
*.jar
!backend/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.7z

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*.cache

# ================================
# TEST & COVERAGE
# ================================
coverage/
.nyc_output/
*.lcov
.jest/
junit.xml
test-results/

# ================================
# KEEP THESE FILES (Exceptions)
# ================================
# Keep example env files
!.env.example
!.env.render.template

# Keep render configuration
!render.yaml

# Keep Maven wrapper
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/mvnw
!backend/mvnw.cmd

# Keep Gradle wrapper
!minetsacco-main/android/gradle/wrapper/gradle-wrapper.jar
!minetsacco-main/android/gradlew
!minetsacco-main/android/gradlew.bat

# ================================
# PROJECT SPECIFIC
# ================================
# PowerShell scripts for local use only
START_BACKEND_SERVER.ps1
CHECK_SERVER_STATUS.ps1
QUICK_START.md
APK_SERVER_SETUP_GUIDE.md

# Build output APKs/AABs (too large for GitHub)
*.apk
*.aab
minetsacco-*.apk
minetsacco-*.aab

# Migration scripts with sensitive data
**/RESET_*.sql
**/DELETE_*.sql
**/FIX_*.sql
**/DIAGNOSE_*.sql
